#!/usr/bin/env bash
# This script creates a PID file and handles signals while running indefinitely

echo $$ > /var/run/myscript.pid

trap 'echo "Y U no love me?!"; rm -f /var/run/myscript.pid; exit' SIGINT
trap 'echo "I hate the kill command"; rm -f /var/run/myscript.pid; exit' SIGTERM SIGQUIT

while true
do
    echo "To infinity and beyond"
    sleep 2
done
